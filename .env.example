# ============================================================
# MotoDash AI — Variables de Entorno (Plantilla de Ejemplo)
# Copia este archivo como `.env.local` y completa tus claves.
# NUNCA subas `.env` ni `.env.local` a GitHub.
# ============================================================

# 1. Google Gemini AI (Opcional — la app incluye catálogo offline de respaldo)
VITE_GEMINI_API_KEY=

# 2. Supabase Cloud Sync & Auth (Opcional — la app funciona 100% offline-first sin esto)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Pasarelas de Pago de Suscripciones (Opcional — Lemon Squeezy Global & Wompi Colombia)
VITE_LEMONSQUEEZY_SOLO_URL=
VITE_LEMONSQUEEZY_PRO_URL=
VITE_LEMONSQUEEZY_GARAGE_URL=
VITE_WOMPI_CHECKOUT_URL=
